  "info": {
    "title": "AnimeHub API",
    "description": "Contrato público REST compartido por AnimeHub Web y Desktop.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://animehub-api.duardo.dev",
      "description": "Producción"
    },
    {
      "url": "http://localhost:8000",
      "description": "Desarrollo local"
    }
  ],
  "components": {
    "securitySchemes": {
      "jobCapability": {
        "scheme": "bearer",
        "bearerFormat": "opaque capability",
        "type": "http",
        "description": "Capacidad opaca y temporal devuelta al crear un trabajo de descarga; no es un JWT."
      }
    },
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
