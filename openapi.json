    "/api/v1/catalog": {
      "get": {
        "operationId": "CatalogController_getCatalog",
        "parameters": [
          {
            "name": "maxYear",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            }
          },
          {
            "name": "minYear",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            }
          },
          {
            "name": "genre",
            "required": false,
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["emision", "finalizado", "proximamente"],
              "type": "string"
            }
          },
          {
            "name": "letter",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 1,
              "type": "string"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "score",
                "popular",
                "title",
                "latest_added",
                "latest_released"
