{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^devalue$": "<rootDir>/mocks/devalue.mock.cjs",
    "^p-limit$": "<rootDir>/mocks/p-limit.mock.cjs",
    "^pg-boss$": "<rootDir>/mocks/pg-boss.mock.cjs"
  }
}
