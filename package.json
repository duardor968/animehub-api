{
  "name": "@animehub/api",
  "version": "0.1.0",
  "description": "API pública REST de AnimeHub",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch --path tsconfig.dev.json",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" \"prisma.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "openapi:generate": "prisma generate && nest build && node dist/generate-openapi.js && prettier --write openapi.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL is required for integration tests')\" && vitest run src/home/home-store.integration.spec.ts",
    "format:check": "prettier --check .",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- openapi.json",
    "prisma:migrate": "prisma migrate deploy",
    "test:shutdown": "node scripts/check-shutdown.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.2.5",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "devalue": "5.9.3",
    "fastify": "5.12.5",
    "p-limit": "7.3.1",
    "pg": "8.22.0",
    "pg-boss": "12.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.3.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.20.0"
  }
}
